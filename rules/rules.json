          "tier": "strong",
          "pattern": "onnxruntime*.dll",
          "match": "glob",
          "category": "inference_runtime",
          "severity": 2,
          "confidence": 0.35,
          "description": "进程拥有可见窗口且加载了 ONNX Runtime（AI 推理运行时）",
          "advice": "装了 CUDA/ONNX 的开发机也会命中，需结合路径、签名与使用场景"
        },
        {
          "id": "vision.capture.opencv",
          "tier": "strong",
          "pattern": "opencv_world*.dll",
          "match": "glob",
          "category": "cv_library",
          "severity": 2,
          "confidence": 0.3,
          "description": "进程拥有可见窗口且加载了 OpenCV（含 dnn 模块的发行版）"
        },
        {
          "id": "vision.capture.tensorrt",
          "tier": "strong",
          "pattern": "nvinfer*.dll",
