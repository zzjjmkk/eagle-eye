  "deep": {
    "handles": {
      "enabled": true,
      "rules": [
        {
          "id": "handle.game_process_access",
          "category": "handle",
          "targetProcessPattern": "*DeltaForce*",
          "accessMaskAny": [
            "0x10",
            "0x20",
            "0x2"
          ],
          "severity": 5,
          "confidence": 0.7,
          "description": "有进程以 VM_READ / VM_WRITE / CREATE_THREAD 打开了三角洲行动客户端进程",
          "advice": "这是本机最强的作弊信号之一：除反作弊自身外，正常软件不应读取游戏内存"
        },
        {
          "id": "handle.vm_read_remote",
          "category": "handle",
          "targetProcessPattern": "*DeltaForce*",
          "accessMaskAny": [
            "0x10"
          ],
          "severity": 3,
          "confidence": 0.5,
          "description": "进程以 VM_READ 打开了另一个进程（具备读取对方内存的能力）",
          "advice": "调试器、杀软、系统组件也可能如此，需结合签名与场景判断"
        },
        {
          "id": "handle.vm_write_remote",
          "category": "handle",
          "targetProcessPattern": "*DeltaForce*",
          "accessMaskAny": [
            "0x20"
          ],
          "severity": 4,
          "confidence": 0.65,
          "description": "进程以 VM_WRITE 打开了另一个进程（具备写入对方内存的能力）",
          "advice": "正常软件极少需要 VM_WRITE 他人进程，优先复核"
        },
        {
          "id": "handle.create_thread_remote",
          "category": "handle",
          "targetProcessPattern": "*DeltaForce*",
          "accessMaskAny": [
            "0x2"
          ],
          "severity": 4,
          "confidence": 0.6,
