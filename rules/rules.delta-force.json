      "description": "注入器命名模式"
    },
    {
      "id": "df.module.cheatdll",
      "type": "module_name",
      "pattern": "*deltaforce*cheat*.dll",
      "match": "glob",
      "category": "df.tool",
      "severity": 5,
      "confidence": 0.7,
      "description": "进程加载了名称含 deltaforce+cheat 的模块"
    },
    {
      "id": "df.module.dfhack",
      "type": "module_name",
      "pattern": "*df*hack*.dll",
      "match": "glob",
      "category": "df.tool",
      "severity": 4,
      "confidence": 0.5,
      "description": "加载了名称含 df+hack 的模块"
    },
    {
      "id": "df.file.zh",
      "type": "file_name",
      "pattern": "*三角洲*辅助*.exe",
      "match": "glob",
      "category": "df.tool",
      "severity": 4,
      "confidence": 0.5,
      "description": "文件名同时含「三角洲」与「辅助」"
    },
    {
      "id": "df.file.wall",
      "type": "file_name",
      "pattern": "*三角洲*透视*.exe",
      "match": "glob",
      "category": "df.tool",
      "severity": 4,
      "confidence": 0.5,
      "description": "文件名同时含「三角洲」与「透视」"
    },
    {
      "id": "df.file.ct",
      "type": "file_name",
      "pattern": "*.ct",
      "match": "glob",
      "category": "df.name",
      "severity": 2,
      "confidence": 0.3,
      "description": "Cheat Engine 表文件（.ct），常见于数值修改与训练脚本"
    },
    {
      "id": "df.file.kmboxdll",
      "type": "file_name",
      "pattern": "*kmbox*.dll",
      "match": "glob",
      "category": "df.loader",
      "severity": 4,
      "confidence": 0.5,
      "description": "KMBox 类硬件输入模拟器的配套 DLL"
    }
