  "whitelist": {
    "processes": [
      {
        "pattern": "DeltaForceClient*",
        "match": "glob",
        "reason": "游戏本体"
      },
      {
        "pattern": "*DeltaForce*Shipping.exe",
        "match": "glob",
        "reason": "游戏本体（UE Shipping 进程）"
      },
      {
        "pattern": "ACE-*",
        "match": "glob",
        "reason": "腾讯 ACE 反作弊组件"
      },
      {
        "pattern": "SGuard*",
        "match": "glob",
        "reason": "ACE 安全组件"
      },
      {
        "pattern": "WeGame*",
        "match": "glob",
        "reason": "WeGame 平台"
      },
      {
        "pattern": "steam*",
        "match": "glob",
        "reason": "Steam 平台"
      },
      {
        "pattern": "nvcontainer.exe",
        "match": "exact",
        "reason": "NVIDIA 容器"
      }
    ],
    "paths": [
      {
        "pattern": "*\\Tencent\\*ACE*\\*",
        "reason": "ACE 安装目录"
      },
      {
        "pattern": "*\\WeGameApps\\*",
        "reason": "WeGame 安装目录"
      }
    ],
    "files": [],
    "signers": [
      {
        "subjectContains": "Tencent Technology",
        "reason": "腾讯签名组件"
      },
      {
        "subjectContains": "Microsoft",
        "reason": "微软签名"
      }
    ]
  }
}