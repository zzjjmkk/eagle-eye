      "description": "KMBox 类硬件鼠标模拟器配套软件"
    },
    {
      "id": "df.loader.kmnet",
      "type": "process_name",
      "pattern": "*kmnet*",
      "match": "glob",
      "category": "df.loader",
      "severity": 4,
      "confidence": 0.5,
      "description": "KMNet 类网络转发输入设备配套程序"
