    {
      "id": "df.loader.aim",
      "type": "process_name",
      "pattern": "*aim*loader*",
      "match": "glob",
      "category": "df.loader",
      "severity": 4,
      "confidence": 0.5,
      "description": "自瞄类加载器命名模式"
    },
    {
      "id": "df.loader.injector",
      "type": "process_name",
      "pattern": "*injector*",
      "match": "glob",
      "category": "df.loader",
      "severity": 3,
