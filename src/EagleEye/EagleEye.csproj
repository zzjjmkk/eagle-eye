<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>EagleEye</AssemblyName>
    <RootNamespace>EagleEye</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Company>Tone Wang</Company>
    <Authors>Tone Wang</Authors>
    <Copyright>Copyright (c) 2026 Tone Wang</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Eagle Eye</Product>
    <Description>Eagle Eye — 本地反外挂只读查询工具（进程/文件/驱动/句柄/DMA/视觉链路）</Description>
    <EnableDefaultNoneItems>true</EnableDefaultNoneItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- 规则统一放在仓库根 rules\，构建时复制到输出目录的 rules\ -->
  <ItemGroup>
    <None Include="..\..\rules\rules.json" Link="rules\rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\rules\rules.delta-force.json" Link="rules\rules.delta-force.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\rules\rules.intel.json" Link="rules\rules.intel.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>